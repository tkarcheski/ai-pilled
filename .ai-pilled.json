{
  "version": 1,
  "commands": {
    "test": [
      "python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-v"
    ],
    "benchmark": [
      "python",
      "-m",
      "ai_pilled",
      "scan"
    ],
    "lint": [
      ".ai-pilled/tools/bin/ruff",
      "check",
      "--isolated",
      "--no-cache",
      "--target-version",
      "py310",
      "--select",
      "E4,E7,E9,F,B,S",
      "--per-file-ignores",
      "tests/*:S603,tests/*:S607",
      "ai_pilled",
      "tests",
      "scripts"
    ],
    "typecheck": [
      ".ai-pilled/tools/bin/mypy",
      "--no-incremental",
      "--cache-dir=/dev/null",
      "--check-untyped-defs",
      "ai_pilled"
    ],
    "deadcode": [
      ".ai-pilled/tools/bin/vulture",
      "ai_pilled",
      "--min-confidence",
      "100"
    ],
    "coverage": [
      ".ai-pilled/tools/bin/python",
      "scripts/check_coverage.py"
    ],
    "simplify": [
      ".ai-pilled/tools/bin/ruff",
      "check",
      "--isolated",
      "--no-cache",
      "--fix",
      "--select",
      "F401",
      "ai_pilled",
      "tests",
      "scripts"
    ],
    "repair": [
      ".ai-pilled/tools/bin/ruff",
      "check",
      "--isolated",
      "--no-cache",
      "--fix",
      "--select",
      "E4,E7,E9,F",
      "ai_pilled",
      "tests",
      "scripts"
    ]
  },
  "protected_branches": [
    "main",
    "master"
  ],
  "require_tests": true,
  "timeout": 120,
  "aggressiveness": "strict",
  "review_checks_on_commit": true,
  "python_requirements": [
    "requirements-dev.txt"
  ],
  "python_audit_executable": ".ai-pilled/python-audit-tools/bin/pip-audit",
  "audit_dependencies_on_change": true
}
